# The Asthetik - Environment Configuration
PORT=3000

# Optional backup booking webhook URL (e.g. Google Apps Script Webhook, Make/Zapier webhook, or custom email endpoint)
# Bookings are always delivered via WhatsApp; this webhook acts as a background backup.
# BOOKING_BACKUP_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
# BOOKING_BACKUP_SECRET_KEY=your_optional_secret
